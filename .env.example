# Ollama Configuration (local default)
TERMWHAT_OLLAMA_HOST=http://ollama:11434
TERMWHAT_MODEL=qwen3.5:4b
TERMWHAT_TIMEOUT=60000

# Ollama Cloud (https://ollama.com) — optional
# TERMWHAT_OLLAMA_API_KEY=your-ollama-cloud-key
# TERMWHAT_OLLAMA_HOST=https://ollama.com
# TERMWHAT_MODEL=gpt-oss:120b

# For external Ollama on LAN:
# TERMWHAT_OLLAMA_HOST=http://192.168.1.100:11434

# Secondary providers
# TERMWHAT_OPENAI_API_KEY=
# TERMWHAT_ANTHROPIC_API_KEY=
# TERMWHAT_OPENROUTER_API_KEY=
# TERMWHAT_PROVIDER=ollama
