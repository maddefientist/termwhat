{
  "name": "termwhat",
  "version": "3.0.0",
  "description": "Ask your terminal what command you need. Ollama-first AI command suggestions that never run anything without you.",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maddefientist/termwhat.git"
  },
  "homepage": "https://github.com/maddefientist/termwhat#readme",
  "bugs": {
    "url": "https://github.com/maddefientist/termwhat/issues"
  },
  "author": "maddefientist",
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map"
  ],
  "bin": {
    "termwhat": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint src/",
    "test": "node --test dist/**/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": ["cli","terminal","ollama","openai","anthropic","openrouter","ai","command-line","llm","shell","developer-tools","productivity"],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "commander": "^15.0.0",
    "ollama": "^0.6.3",
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
