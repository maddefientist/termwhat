{
  "name": "termwhat",
  "version": "3.1.0",
  "description": "Ask your terminal what command you need. Ollama-first AI command suggestions that never run anything without you.",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maddefientist/termwhat.git"
  },
  "homepage": "https://github.com/maddefientist/termwhat#readme",
  "bugs": {
    "url": "https://github.com/maddefientist/termwhat/issues"
  },
  "author": "maddefientist",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "bin": {
    "termwhat": "dist/index.js",
    "term": "dist/term.js"
  },
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc && chmod +x dist/index.js dist/term.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint src/",
    "test": "find dist -name '*.test.js' -print0 | xargs -0r node --test",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "cli",
    "terminal",
    "ollama",
    "openai",
    "anthropic",
    "openrouter",
    "ai",
    "command-line",
    "llm",
    "shell",
    "developer-tools",
    "productivity"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "commander": "^15.0.0",
    "ollama": "^0.6.3",
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
